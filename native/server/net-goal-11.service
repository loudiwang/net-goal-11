[Unit]
Description=Net Goal 11 native UDP relay
Documentation=https://github.com/example/net-goal-11
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=net-goal-11
ExecStart="/opt/net-goal-11/Net Goal 11.Server" --port 45888 --subnet 10.213.77.0 --mask 255.255.255.0 --max-peers 16 --key-file /var/lib/net-goal-11/server.key
Restart=always
RestartSec=2
LimitNOFILE=65535
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
